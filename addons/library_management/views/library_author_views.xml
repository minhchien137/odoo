<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="view_library_author_list" model="ir.ui.view">
    <field name="name">library.author.list</field>
    <field name="model">library.author</field>
    <field name="arch" type="xml">
        <list string="Danh sách tác giả">
            <field name="name"/>
            <field name="email"/>
            <field name="phone"/>
            <field name="date_of_birth"/>
        </list>
    </field>
</record>


    <record id="view_library_author_form" model="ir.ui.view">
        <field name="name">library.author.form</field>
        <field name="model">library.author</field>
        <field name="arch" type="xml">
            <form string="Thông tin tác giả">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="date_of_birth"/>
                            <field name="sex"/>
                            <field name="active"/>
                        </group>
                        <group>
                           <field name="cover_image" widget="image" class="oe_avatar" options="{'size': [90, 90]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Thông tin khác">
                            <field name="address"/>
                            <field name="biography"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>




     <!-- Search View -->
    <record id="view_library_author_search" model="ir.ui.view">
        <field name="name">library.author.search</field>
        <field name="model">library.author</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm tác giả">
                <field name="name" string="Tên tác giả"/>
                <field name="email" string="Email"/>
                <field name="phone" string="Số điện thoại"/>
                <field name="date_of_birth" string="Ngày sinh"/>

                
                <separator/>
                <filter string="Hoạt động" name="active" 
                        domain="[('active', '=', True)]"/>
                
                <group expand="0" string="Nhóm theo">
                    <filter string="Ngày sinh" name="group_date_of_birth" 
                            context="{'group_by': 'date_of_birth'}"/>
                  
                </group>
            </search>
        </field>
    </record>

    <!-- Action - Cập nhật view_mode -->
    <record id="action_library_author" model="ir.actions.act_window">
        <field name="name">Quản lý tác giả</field>
        <field name="res_model">library.author</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo tác giả đầu tiên!
            </p>
            <p>
                Nhấp để thêm tác giả mới vào thư viện.
            </p>
        </field>
    </record>


</odoo>