<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View (thay đổi từ tree thành list) -->
    <record id="view_library_book_tree" model="ir.ui.view">
        <field name="name">library.book.list</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list string="Danh sách sách">
                <field name="name"/>
                <field name="author"/>
                <field name="category"/>
                <field name="state" decoration-success="state == 'available'" 
                       decoration-warning="state == 'borrowed'" 
                       decoration-danger="state == 'lost'"/>
                <field name="borrower_id" optional="hide"/>
                <field name="borrow_date" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_library_book_form" model="ir.ui.view">
        <field name="name">library.book.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form string="Thông tin sách">
                <header>
                    <button name="action_borrow" string="Mượn sách" 
                            type="object" class="btn-primary" 
                            invisible="state != 'available'"/>
                    <button name="action_return" string="Trả sách" 
                            type="object" class="btn-success" 
                            invisible="state != 'borrowed'"/>
                    <button name="action_maintenance" string="Bảo trì" 
                            type="object" class="btn-warning" 
                            invisible="state in ['maintenance', 'lost']"/>
                    <button name="action_available" string="Có sẵn" 
                            type="object" class="btn-info" 
                            invisible="state not in ['maintenance']"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="available,borrowed,maintenance"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- Có thể thêm smart buttons ở đây -->
                    </div>
                    <div class="oe_avatar">
                        <field name="cover_image" widget="image" class="oe_avatar" options="{'size': [90, 90]}"/>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Nhập tên sách..." required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Thông tin cơ bản">
                            <field name="author"/>
                            <field name="isbn"/>
                            <field name="publisher"/>
                            <field name="publication_date"/>
                        </group>
                        <group string="Chi tiết">
                            <field name="pages"/>
                            <field name="category"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Thông tin mượn" invisible="state != 'borrowed'">
                        <group>
                            <field name="borrower_id"/>
                            <field name="borrow_date"/>
                        </group>
                        <group>
                            <field name="return_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Mô tả" name="description">
                            <field name="description" nolabel="1" placeholder="Nhập mô tả sách..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_library_book_search" model="ir.ui.view">
        <field name="name">library.book.search</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm sách">
                <field name="name" string="Tên sách"/>
                <field name="author" string="Tác giả"/>
                <field name="isbn" string="ISBN"/>
                <field name="borrower_id" string="Người mượn"/>
                
                <filter string="Có sẵn" name="available" 
                        domain="[('state', '=', 'available')]"/>
                <filter string="Đã mượn" name="borrowed" 
                        domain="[('state', '=', 'borrowed')]"/>
                <filter string="Bảo trì" name="maintenance" 
                        domain="[('state', '=', 'maintenance')]"/>
                
                <separator/>
                <filter string="Hoạt động" name="active" 
                        domain="[('active', '=', True)]"/>
                
                <group expand="0" string="Nhóm theo">
                    <filter string="Trạng thái" name="group_state" 
                            context="{'group_by': 'state'}"/>
                    <filter string="Thể loại" name="group_category" 
                            context="{'group_by': 'category'}"/>
                    <filter string="Tác giả" name="group_author" 
                            context="{'group_by': 'author'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action - Cập nhật view_mode -->
    <record id="action_library_book" model="ir.actions.act_window">
        <field name="name">Quản lý sách</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo sách đầu tiên!
            </p>
            <p>
                Nhấp để thêm sách mới vào thư viện.
            </p>
        </field>
    </record>

</odoo>